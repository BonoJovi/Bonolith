{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Bonolith ConversionCase",
  "type": "object",
  "required": ["id", "input_hiragana", "expected", "expected_readings", "category", "pos_solvable", "date_collected"],
  "properties": {
    "id": { "type": "string", "pattern": "^case_[0-9]{4}$" },
    "input_hiragana": { "type": "string" },
    "input_romaji": { "type": "string" },
    "expected": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "expected_readings": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Per-phrase hiragana readings aligned 1:1 with `expected`. Concatenation must equal `input_hiragana`. Used by the conversion-quality harness to derive bunsetsu boundaries for the refinement check." },
    "actual": { "type": "array", "items": { "type": "string" } },
    "category": { "enum": ["segmentation", "word_choice", "inflection", "both"] },
    "subcategory": { "type": "string" },
    "pos_solvable": { "enum": ["yes", "partial", "no"] },
    "pos_hypothesis": { "type": "string" },
    "notes": { "type": "string" },
    "date_collected": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "bonolith_version": { "type": "string" },
    "source": { "enum": ["generated", "user_reported", "captured"] }
  }
}
